# ── Backend env mẫu — copy sang .env rồi điền giá trị thật ──
# (.env thật KHÔNG commit; file này chỉ liệt kê biến cần có)

PORT=5000
# ĐỔI THÀNH production KHI DEPLOY. Thiếu biến này thì log rớt về mức debug và
# morgan mất định dạng combined. (/api-docs đã fail-closed nên không hở nữa.)
NODE_ENV=development
# Local: mongodb://127.0.0.1:27017/toeic
# Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/<db>?retryWrites=true&w=majority
# Lưu ý nếu dùng dạng `mongodb+srv://`: driver phải tra SRV/TXT qua DNS, mà
# server.js:4 đang ép resolver về 8.8.8.8 — nền tảng nào chặn DNS ra ngoài thì
# app chết lúc khởi động với lỗi DNS khó lần. Xem DEPLOY-deployment-011.
MONGODB_URI=mongodb://127.0.0.1:27017/toeic

# Sinh chuỗi mạnh:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
# Đăng xuất KHÔNG thu hồi được token (server chưa giữ danh sách đen), nên hạn này
# CHÍNH LÀ thời gian một token rò rỉ còn dùng được. Đừng đặt dài.
# Phải khớp DEFAULT_JWT_EXPIRE trong models/User.js — đã hạ từ 7d xuống 12h có
# chủ ý. Để 7d ở đây là copy example xong mất luôn bản vá đó.
JWT_EXPIRE=12h

# ── Vận hành ─────────────────────────────────────────────────────────────────
# Origin của frontend, phân tách bằng dấu phẩy. BỎ TRỐNG = chỉ cho localhost →
# frontend deploy ở host khác sẽ bị chặn CORS, mà server log nhìn vẫn bình thường.
# Backend hiện phục vụ luôn bản build (cùng origin) nên thường KHÔNG cần đặt;
# chỉ cần khi tách frontend sang host riêng.
CORS_ORIGIN=

# Redis cho cache + hàng đợi email. BỎ TRỐNG = rơi về redis://localhost:6379;
# trên platform không có Redis thì queue lặng lẽ chạy fallback, email degrade mà
# không một dòng lỗi.
REDIS_URL=

# Số CHẶNG proxy đứng trước app (Render/Railway/Nginx = 1). Sai số này thì rate
# limit dồn mọi người vào một rổ và IP trong log vô nghĩa. Mặc định 1.
TRUST_PROXY_HOPS=

# Mở /api-docs trên server thật. Để trống = ĐÓNG (chỉ mở khi NODE_ENV=development).
# Bật lên là công khai bản đồ mọi endpoint kèm client bấm thử — cân nhắc.
ENABLE_API_DOCS=

# Ghi log ra file xoay vòng trong ./logs. Chỉ đặt `true` khi deploy có ổ đĩa BỀN
# (VPS + docker-compose mount /app/logs). Trên Render/Railway để trống: thư mục
# container là ephemeral, log ghi ra đó không ai đọc được và mất mỗi lần redeploy —
# transport console đã đẩy JSON ra stdout cho nền tảng thu rồi.
LOG_TO_FILE=

# AI (tùy chọn)
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Email (tùy chọn)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Đăng nhập Google (tùy chọn)
GOOGLE_CLIENT_ID=

# ── Cloudinary — lưu ảnh/audio TOEIC trên cloud thay vì đĩa ──
# Thiếu cả 3 biến này → hệ thống tự lưu ĐĨA (public/assets) như cũ, dev/local
# chạy bình thường. Điền đủ 3 → upload đẩy lên Cloudinary (sống qua redeploy).
# Lấy ở: Cloudinary Dashboard → Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
