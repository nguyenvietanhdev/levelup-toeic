# ===================================
# ENVIRONMENT VARIABLES - COPY TO .env
# ===================================
# cp .env.example .env  (Linux/Mac)
# copy .env.example .env  (Windows)

# Server
PORT=5000
NODE_ENV=development   # đổi thành production khi deploy

# CORS - domain frontend được phép gọi API
# Nếu frontend và backend cùng origin (same server) thì bỏ trống
# Nếu khác domain: CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=Cluster0

# JWT - generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRE=7d

# Email OTP (Gmail App Password)
# Hướng dẫn: myaccount.google.com → Security → App passwords → Mail
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx
EMAIL_FROM=LevelUp TOEIC <your_gmail@gmail.com>

# OpenAI (optional - for AI helper feature)
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# Pixabay (optional - for vocabulary images)
PIXABAY_API_KEY=...

# Google Gemini (optional)
GEMINI_API_KEY=...

# DeepSeek (optional)
DEEPSEEK_API_KEY=...
